---
import Base from "../../layouts/Base.astro";
import Head from "../../components/Head.astro";
import { getEntryBySlug, getCollection } from "astro:content";
import Navbar from "../../components/Navbar.astro";

export async function getStaticPaths() {
  const items = await getCollection("our-work");
  return items.map(item => ({ params: { slug: item.slug } }));
}

const { slug } = Astro.params;
const item = await getEntryBySlug("our-work", slug);
let metaTitle = "Not Found | YouthTechNet Our Work";
let metaDescription = "Sorry, this item could not be found.";
let metaImage = undefined;
let sections = {};
let otherItems = [];
if (item) {
  metaTitle = item.data.title + " | YouthTechNet Our Work";
  const body = item.body.replace(/\r\n/g, "\n");
  // Extract first section content for meta description
  const firstSectionMatch = body.match(/##\s+\S+\n+([\s\S]*?)(\n+##\s+\S+|$)/);
  metaDescription = firstSectionMatch?.[1]?.trim() || item.data.title;
  metaImage = item.data.cover;
  // Dynamically extract all ## sections from body
  const sectionRegex = /##\s+(\S[\s\S]*?)\n+([\s\S]*?)(?=##\s+\S+|$)/g;
  let match;
  while ((match = sectionRegex.exec(body)) !== null) {
    const sectionTitle = match[1].trim();
    const sectionContent = match[2].trim();
    if (sectionTitle && sectionContent) {
      sections[sectionTitle] = sectionContent;
    }
  }
  // Get other items for sidebar
  const allItems = await getCollection("our-work");
  otherItems = allItems.filter(other => other.slug !== slug);
}

---



<Base>
  <Head
    title={metaTitle}
    image={metaImage}
    meta-description={metaDescription}
    meta-author={item?.data?.authors?.join(', ') || 'Unknown Author'}
    meta-date={item?.data?.date}
    meta-tags={item?.data?.tags}
  />
  <Navbar />
  <main class="w-full flex justify-center bg-gradient-to-br from-gray-50 to-white min-h-screen py-8 px-1">
    <div class="w-full max-w-[96rem] bg-white rounded-2xl shadow-2xl p-0 md:p-8 flex flex-col md:flex-row gap-0">
      <div class="flex-1 flex flex-col md:pr-14">
      {item?.data?.cover && (
        <div class="w-full flex items-center justify-center bg-gray-100 rounded-t-2xl overflow-hidden mb-8">
          <img src={item.data.cover} alt={item.data.title + ' cover'} class="object-cover w-full h-72 md:h-96" loading="lazy" />
        </div>
      )}
      <div class="flex flex-col w-full mb-8">
        <h1 class="text-4xl font-extrabold text-royalOrchid leading-tight mb-2 text-left">{item?.data?.title || 'Untitled'}</h1>
        <div class="flex flex-wrap items-center gap-4 mb-4">
          <span class="text-gray-500 text-sm">
            <strong>Date Published:</strong> {item?.data?.date || 'N/A'}
          </span>
          {item?.data?.pdf && (
            <a href={item.data.pdf} target="_blank" rel="noopener" class="text-royalOrchid underline font-semibold text-sm">Download PDF</a>
          )}
        </div>
      </div>
      <div class="flex flex-wrap gap-6 mb-8">
        {item?.data?.authors?.map((author, idx) => (
          <div class="flex items-center bg-white text-gray-900 rounded-xl shadow-lg px-6 py-4 min-w-[220px] max-w-lg border border-gray-300" key={author+idx+100}>
            <span class="inline-block w-14 h-14 rounded-full bg-gray-200 flex items-center justify-center text-2xl font-bold text-royalOrchid border-2 border-royalOrchid mr-4">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118A7.5 7.5 0 0112 15.75a7.5 7.5 0 017.5 4.368" />
              </svg>
            </span>
            <div>
              <div class="font-semibold text-lg text-gray-900">{author}</div>
              <div class="text-xs text-gray-500">Community Member, YouthTechNet</div>
            </div>
          </div>
        ))}
        {!item?.data?.authors?.length && (
          <div class="flex items-center bg-white text-gray-900 rounded-xl shadow-lg px-6 py-4 min-w-[220px] max-w-lg border border-gray-300">
            <span class="inline-block w-14 h-14 rounded-full bg-gray-200 flex items-center justify-center text-2xl font-bold text-royalOrchid border-2 border-royalOrchid mr-4">?
            </span>
            <div>
              <div class="font-semibold text-lg text-gray-900">Lorem Ipsum</div>
              <div class="text-xs text-gray-500">Community Member, YouthTechNet</div>
            </div>
          </div>
        )}
      </div>
      {item?.data?.contributors?.length && (
        <div class="mb-8">
          <h2 class="text-lg font-semibold text-gray-700 mb-3">Contributors</h2>
          <div class="flex flex-wrap gap-4">
            {item?.data?.contributors?.map((contributor, idx) => (
              <div class="flex items-center bg-gray-50 rounded-lg px-4 py-2 text-sm text-gray-600" key={contributor+idx}>
                {contributor}
              </div>
            ))}
          </div>
        </div>
      )}
      <div class="mb-8">
        <h2 class="text-lg font-semibold text-gray-700 mb-2">Tags</h2>
        <div class="flex flex-wrap gap-2">
          {item?.data?.tags?.map(tag => (
            <span class="bg-vividTangerine text-white px-3 py-1 rounded-full text-xs font-medium">{tag}</span>
          ))}
        </div>
      </div>
      <article class="w-full flex flex-col gap-6">
        {Object.entries(sections).map(([title, content]) => (
          <details class="bg-gray-50 rounded-xl shadow border border-gray-300 group" open id={title.toLowerCase()}>
            <summary class="cursor-pointer px-6 py-4 text-xl font-bold text-royalOrchid flex items-center group-open:rounded-t-xl group-open:border-b group-open:bg-gray-100 transition-all">
              <span>{title}</span>
              <svg class="ml-2 w-5 h-5 text-royalOrchid transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-6 pt-2 text-gray-800 prose max-w-none" set:html={content.replace(/\n/g, '<br>')}></div>
          </details>
        ))}
      </article>
      </div>
      {/* Sidebar for other items on the right */}
      <aside class="hidden md:block w-full max-w-xs md:ml-8">
        <div class="sticky top-24">
          <h2 class="text-lg font-bold text-royalOrchid mb-4">Other Work</h2>
          <ul class="space-y-3">
            {otherItems.map(other => (
              <li key={other.slug}>
                <a href={`/our-work/${other.slug}/`} class="block bg-gray-50 hover:bg-vividTangerine/10 border border-gray-300 rounded-lg px-4 py-3 transition-colors shadow-sm">
                  <div class="font-semibold text-gray-900 truncate">{other.data.title}</div>
                  <div class="text-xs text-gray-500 truncate">By {other.data.authors?.join(", ") || "Unknown"}</div>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </main>
</Base>
