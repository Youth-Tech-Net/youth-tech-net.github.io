---
import Base from "../../layouts/Base.astro";
import Head from "../../components/Head.astro";
import { getEntryBySlug, getCollection } from "astro:content";
import Navbar from "../../components/Navbar.astro";

export async function getStaticPaths() {
  const publications = await getCollection("publications");
  return publications.map(pub => ({ params: { slug: pub.slug } }));
}

const { slug } = Astro.params;
const publication = await getEntryBySlug("publications", slug);
let metaTitle = "Publication Not Found | YouthTechNet Publications";
let metaDescription = "Sorry, this publication could not be found.";
let metaImage = undefined;
let sections = {};
let otherPublications = [];
if (publication) {
  metaTitle = publication.data.title + " | YouthTechNet Publications";
  metaDescription = publication.body.match(/## Abstract\n+([\s\S]*?)(\n+## |$)/)?.[1]?.trim() || publication.data.title;
  metaImage = publication.data.cover;
  // Extract sections by heading
  const sectionNames = ["Abstract", "Introduction", "Methods", "Results", "Discussion", "Conclusion"];
  for (let i = 0; i < sectionNames.length; i++) {
    const current = sectionNames[i];
    const next = sectionNames[i + 1];
    const regex = new RegExp(`## ${current}\\n+([\\s\\S]*?)${next ? `(?=## ${next})` : ''}`);
    const match = publication.body.match(regex);
    if (match) {
      sections[current] = match[1].trim();
    }
  }
  // Get other publications for sidebar
  const allPubs = await getCollection("publications");
  otherPublications = allPubs.filter(pub => pub.slug !== slug);
}

---



<Base>
  <Head
    title={metaTitle}
    image={metaImage}
    meta-description={metaDescription}
    meta-author={publication?.data?.authors?.join(', ') || 'Unknown Author'}
    meta-date={publication?.data?.date}
    meta-tags={publication?.data?.tags}
  />
  <Navbar />
  <main class="w-full flex justify-center bg-gradient-to-br from-gray-50 to-white min-h-screen py-8 px-1">
    <div class="w-full max-w-[96rem] bg-white rounded-2xl shadow-2xl p-0 md:p-8 flex flex-col md:flex-row gap-0">
      <div class="flex-1 flex flex-col md:pr-14">
      {publication?.data?.cover && (
        <div class="w-full flex items-center justify-center bg-gray-100 rounded-t-2xl overflow-hidden mb-8">
          <img src={publication.data.cover} alt={publication.data.title + ' cover'} class="object-cover w-full h-72 md:h-96" loading="lazy" />
        </div>
      )}
      <div class="flex flex-col w-full mb-8">
        <h1 class="text-4xl font-extrabold text-royalOrchid leading-tight mb-2 text-left">{publication?.data?.title || 'Untitled Publication'}</h1>
        <div class="flex flex-wrap items-center gap-4 mb-4">
          <span class="text-gray-500 text-sm">
            <strong>Date Published:</strong> {publication?.data?.date || 'N/A'}
          </span>
          {publication?.data?.pdf && (
            <a href={publication.data.pdf} target="_blank" rel="noopener" class="text-royalOrchid underline font-semibold text-sm">Download PDF</a>
          )}
        </div>
      </div>
      <div class="flex flex-wrap gap-6 mb-8">
        {publication?.data?.authors?.map((author, idx) => (
          <div class="flex items-center bg-white text-gray-900 rounded-xl shadow-lg px-6 py-4 min-w-[220px] max-w-lg border border-gray-300" key={author+idx}>
            <span class="inline-block w-14 h-14 rounded-full bg-gray-200 flex items-center justify-center text-2xl font-bold text-royalOrchid border-2 border-royalOrchid mr-4">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118A7.5 7.5 0 0112 15.75a7.5 7.5 0 017.5 4.368" />
              </svg>
            </span>
            <div>
              <div class="font-semibold text-lg text-gray-900">{author}</div>
              <div class="text-xs text-gray-500">Researcher, YouthTechNet</div>
            </div>
          </div>
        ))}
        {!publication?.data?.authors?.length && (
          <div class="flex items-center bg-white text-gray-900 rounded-xl shadow-lg px-6 py-4 min-w-[220px] max-w-lg border border-gray-300">
            <span class="inline-block w-14 h-14 rounded-full bg-gray-200 flex items-center justify-center text-2xl font-bold text-royalOrchid border-2 border-royalOrchid mr-4">?
            </span>
            <div>
              <div class="font-semibold text-lg text-gray-900">Lorem Ipsum</div>
              <div class="text-xs text-gray-500">Researcher, YouthTechNet</div>
            </div>
          </div>
        )}
      </div>
      <div class="mb-8">
        <h2 class="text-lg font-semibold text-gray-700 mb-2">Tags</h2>
        <div class="flex flex-wrap gap-2">
          {publication?.data?.tags?.map(tag => (
            <span class="bg-vividTangerine text-white px-3 py-1 rounded-full text-xs font-medium">{tag}</span>
          ))}
        </div>
      </div>
      <article class="w-full flex flex-col gap-6">
        {Object.entries(sections).map(([title, content]) => (
          <details class="bg-gray-50 rounded-xl shadow border border-gray-300 group" open id={title.toLowerCase()}>
            <summary class="cursor-pointer px-6 py-4 text-xl font-bold text-royalOrchid flex items-center group-open:rounded-t-xl group-open:border-b group-open:bg-gray-100 transition-all">
              <span>{title}</span>
              <svg class="ml-2 w-5 h-5 text-royalOrchid transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-6 pt-2 text-gray-800 prose max-w-none" set:html={content.replace(/\n/g, '<br>')}></div>
          </details>
        ))}
      </article>
      </div>
      {/* Sidebar for other blogs on the right */}
      <aside class="hidden md:block w-full max-w-xs md:ml-8">
        <div class="sticky top-24">
          <h2 class="text-lg font-bold text-royalOrchid mb-4">Other Publications</h2>
          <ul class="space-y-3">
            {otherPublications.map(pub => (
              <li key={pub.slug}>
                <a href={`/publications/${pub.slug}/`} class="block bg-gray-50 hover:bg-vividTangerine/10 border border-gray-300 rounded-lg px-4 py-3 transition-colors shadow-sm">
                  <div class="font-semibold text-gray-900 truncate">{pub.data.title}</div>
                  <div class="text-xs text-gray-500 truncate">By {pub.data.authors?.join(", ") || "Unknown"}</div>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </main>
</Base>
