---
// Props: event (object with title, date, time, image, link)
const { event } = Astro.props;
---
<div class="w-full flex justify-center py-6 px-2">
  <div class="relative flex flex-col md:flex-row items-center bg-gradient-to-r from-vividTangerine via-vanillaCustard to-royalOrchid rounded-lg shadow-2xl border border-royalOrchid max-w-4xl w-full overflow-hidden">
    <img src={event.image} alt={event.title} class="w-full md:w-64 h-48 md:h-64 object-cover object-center rounded-t-lg md:rounded-l-lg md:rounded-tr-none border-b md:border-b-0 md:border-r border-royalOrchid" loading="lazy" />
    <div class="flex-1 flex flex-col justify-center px-6 py-4">
      <div class="flex items-center gap-2 mb-2">
        <span class="inline-block px-3 py-1 bg-white bg-opacity-70 text-royalOrchid font-semibold rounded-full text-xs tracking-widest uppercase shadow">Upcoming Event</span>
      </div>
      <h3 class="text-2xl md:text-3xl font-extrabold text-gray-900 mb-2 italic drop-shadow">{event.title}</h3>
      <div class="flex items-center gap-4 mb-2">
        <span class="flex items-center gap-1 text-gray-700 text-lg">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          {event.date}
        </span>
        <span class="flex items-center gap-1 text-gray-700 text-lg">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          {event.time}
        </span>
      </div>
      <a href={event.link} target="_blank" rel="noopener" class="inline-block mt-2 px-6 py-2 bg-royalOrchid text-white font-semibold rounded-full shadow hover:bg-vividTangerine transition-colors text-lg border border-royalOrchid italic">
        RSVP / More Info
      </a>
    </div>
  </div>
</div>
