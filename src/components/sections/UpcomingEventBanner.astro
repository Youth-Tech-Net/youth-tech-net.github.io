---
// Props: event (object with title, date, time, image, link)
const { event } = Astro.props;
---
<div class="w-full flex justify-center py-6 px-2">
  <div class="relative flex flex-col md:flex-row items-stretch bg-gradient-to-br from-[#ffd4a8] via-vanillaCustard to-[#fffdf2] rounded-lg shadow-2xl border border-[#e1a10b] max-w-4xl w-full overflow-hidden">
    <div class="w-full md:w-auto flex items-center justify-center bg-white bg-opacity-30 p-3 md:p-4 border-b md:border-b-0 md:border-r border-[#e1a10b]">
      <img src={event.image} alt={event.title} class="h-64 md:h-80 w-auto max-w-full object-contain rounded shadow-md" loading="lazy" />
    </div>
    <div class="flex-1 flex flex-col justify-center px-6 py-4">
      <div class="flex items-center gap-2 mb-2">
        <span class="inline-block px-3 py-1 bg-white bg-opacity-70 text-royalOrchid font-semibold rounded-full text-xs tracking-widest uppercase shadow">Upcoming Event</span>
      </div>
      <h3 class="text-2xl md:text-3xl font-extrabold text-[#1a1a1a] mb-2 pixel-font drop-shadow" style="text-shadow: 2px 2px 0 #ffe975, 4px 4px 0 #e1a10b;">{event.title}</h3>
      <div class="flex items-center gap-4 mb-2">
        <span class="flex items-center gap-1 text-[#5a4230] text-lg">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          {event.date}
        </span>
        <span class="flex items-center gap-1 text-[#5a4230] text-lg">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          {event.time}
        </span>
      </div>
      <a href={event.link} target="_blank" rel="noopener" class="inline-block mt-2 px-6 py-2 bg-vividTangerine text-[#1a1a1a] font-semibold rounded-full shadow hover:bg-[#e84037] hover:text-white transition-colors text-lg border border-[#cc6600] italic">
        RSVP / More Info
      </a>
    </div>
  </div>
</div>
