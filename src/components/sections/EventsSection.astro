---
const { upcoming, past } = Astro.props;
import FacebookIcon from "../FacebookIcon.astro";
---
<section class="py-16 bg-white">
  <div class="max-w-5xl mx-auto px-4">
    <h1 class="text-3xl sm:text-4xl font-bold text-royalOrchid mb-8 text-center">
      Events
    </h1>
    <div class="flex justify-center mb-8">
      <button id="tab-upcoming" type="button" class="tab-btn px-6 py-2 rounded-t-lg font-semibold text-lg focus:outline-none border-b-2 border-royalOrchid bg-white text-royalOrchid" onclick="showTab('upcoming')">Upcoming</button>
      <button id="tab-past" type="button" class="tab-btn px-6 py-2 rounded-t-lg font-semibold text-lg focus:outline-none border-b-2 border-transparent bg-white text-gray-400 hover:text-royalOrchid" onclick="showTab('past')">Past</button>
    </div>
    <div id="tab-content-upcoming" class="tab-content">
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-10">
        {upcoming.length === 0 && <p class="col-span-4 text-center">No upcoming events.</p>}
        {upcoming.slice(0, 5).map((event: any) => (
          <div class="flex flex-col bg-white rounded-2xl shadow-2xl border border-vanillaCustard hover:shadow-3xl transition-shadow duration-300 overflow-hidden min-h-[480px]">
            <img src={event.image} alt={event.title} class="w-full h-80 object-cover object-top rounded-t-xl" loading="lazy" />
            <div class="flex-1 flex flex-col px-6 py-6">
              <h3 class="text-2xl font-bold text-royalOrchid mb-3">{event.title}</h3>
              <div class="mb-3 space-y-1">
                <p class="flex items-center gap-2 text-gray-500 text-lg">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                  </svg>
                  {event.date}
                </p>
                <p class="flex items-center gap-2 text-gray-500 text-lg">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  {event.time}
                </p>
              </div>
              <a href={event.link} target="_blank" rel="noopener" class="mt-auto flex items-center gap-2 text-blue-600 hover:text-vividTangerine font-semibold transition-colors text-lg">
                {/* <FacebookIcon class="w-6 h-6 border border-blue-400 rounded" /> */}
                <span class="italic">Tickets / More Info</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
    <div id="tab-content-past" class="tab-content hidden">
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-10">
        {past.length === 0 && <p class="col-span-4 text-center">No past events.</p>}
        {past.slice(0, 5).map((event: any) => (
          <div class="flex flex-col bg-gray-50 rounded-2xl shadow-2xl border border-vanillaCustard hover:shadow-3xl transition-shadow duration-300 overflow-hidden opacity-80 min-h-[480px]">
            <img src={event.image} alt={event.title} class="w-full h-80 object-cover object-top rounded-t-xl grayscale" loading="lazy" />
            <div class="flex-1 flex flex-col px-6 py-6">
              <h3 class="text-2xl font-bold text-gray-700 mb-3">{event.title}</h3>
              <div class="mb-3 space-y-1">
                <p class="flex items-center gap-2 text-gray-400 text-lg">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                  </svg>
                  {event.date}
                </p>
                <p class="flex items-center gap-2 text-gray-400 text-lg">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  {event.time}
                </p>
              </div>
              <a href={event.link} target="_blank" rel="noopener" class="mt-auto flex items-center gap-2 text-blue-600 hover:text-vividTangerine font-semibold transition-colors text-lg">
                <FacebookIcon class="w-6 h-6 p-1 border border-blue-400 rounded" />
                <span class="italic">Event Page</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
    <script is:inline>
      function showTab(tab) {
        document.getElementById('tab-content-upcoming').classList.toggle('hidden', tab !== 'upcoming');
        document.getElementById('tab-content-past').classList.toggle('hidden', tab !== 'past');
        document.getElementById('tab-upcoming').classList.toggle('border-royalOrchid', tab === 'upcoming');
        document.getElementById('tab-upcoming').classList.toggle('text-royalOrchid', tab === 'upcoming');
        document.getElementById('tab-upcoming').classList.toggle('text-gray-400', tab !== 'upcoming');
        document.getElementById('tab-past').classList.toggle('border-royalOrchid', tab === 'past');
        document.getElementById('tab-past').classList.toggle('text-royalOrchid', tab === 'past');
        document.getElementById('tab-past').classList.toggle('text-gray-400', tab !== 'past');
      }
      // Default to upcoming tab
      showTab('upcoming');
    </script>
  </div>
</section>
