---
import type { CollectionEntry } from 'astro:content'
import { getCollection } from 'astro:content'

interface Props {
  entry: CollectionEntry<'sections'>
}

const { entry } = Astro.props
const { title } = entry.data

// Get all team members and sort by order
const teamMembers = (await getCollection('team')).sort((a, b) => {
  const orderA = a.data.order ?? 999
  const orderB = b.data.order ?? 999
  return orderA - orderB
})

// Render the team member content
const membersWithContent = await Promise.all(
  teamMembers.map(async (member) => ({
    ...member.data,
    content: await member.render()
  }))
)
---
<div id="team" class="w-full flex flex-col justify-center items-center py-12 sm:py-20 bg-gray-50">
  <div class="w-full md:w-5/6 xl:w-2/3 px-4 sm:px-8 py-6 sm:py-12 text-center">
    <h2 class="font-bold tracking-widest text-4xl mb-6">{title}</h2>
    <div class="font-light text-gray-600 text-xl mb-12">
      <slot />
    </div>
    <script>
      window.openTeamModal = function(idx) {
        document.querySelectorAll('.team-modal').forEach(m => m.classList.add('hidden'));
        document.getElementById('team-modal-' + idx).classList.remove('hidden');
      }
      window.closeTeamModal = function(idx) {
        document.getElementById('team-modal-' + idx).classList.add('hidden');
      }
    </script>
    <div class="w-full flex flex-col items-center gap-8">
      <div class="flex flex-wrap justify-center gap-10 w-full mb-8">
        {membersWithContent.slice(0, 3).map((member, idx) => (
          <div class="relative group flex flex-col items-center">
            {member.image ? (
              <img
                src={member.image}
                alt={member.name}
                class="w-48 h-48 rounded-full object-cover border-4 border-white shadow-lg transition-transform duration-300 group-hover:scale-105"
              />
            ) : (
              <div class={`w-48 h-48 bg-${member.color} rounded-full flex items-center justify-center text-white text-6xl font-bold border-4 border-white shadow-lg transition-transform duration-300 group-hover:scale-105`}>
                {member.initials}
              </div>
            )}
            <div class="absolute inset-0 flex flex-col items-center justify-center bg-black bg-opacity-80 opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-full text-center p-4 z-10">
              <h3 class="text-xl font-bold text-white mb-1">{member.name}</h3>
              <p class="text-base text-vividTangerine font-semibold mb-2">{member.role}</p>
              <button class="mt-2 px-4 py-1 bg-vividTangerine text-white rounded-full font-bold shadow hover:bg-royalOrchid transition-colors text-sm" onclick={`openTeamModal(${idx})`}>
                See more
              </button>
            </div>
          </div>
        ))}
      </div>
      <div class="flex flex-wrap justify-center gap-10 w-full">
        {membersWithContent.slice(3, 7).map((member, idx) => (
          <div class="relative group flex flex-col items-center">
            {member.image ? (
              <img
                src={member.image}
                alt={member.name}
                class="w-48 h-48 rounded-full object-cover border-4 border-white shadow-lg transition-transform duration-300 group-hover:scale-105"
              />
            ) : (
              <div class={`w-48 h-48 bg-${member.color} rounded-full flex items-center justify-center text-white text-6xl font-bold border-4 border-white shadow-lg transition-transform duration-300 group-hover:scale-105`}>
                {member.initials}
              </div>
            )}
            <div class="absolute inset-0 flex flex-col items-center justify-center bg-black bg-opacity-80 opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-full text-center p-4 z-10">
              <h3 class="text-xl font-bold text-white mb-1">{member.name}</h3>
              <p class="text-base text-vividTangerine font-semibold mb-2">{member.role}</p>
              <button class="mt-2 px-4 py-1 bg-vividTangerine text-white rounded-full font-bold shadow hover:bg-royalOrchid transition-colors text-sm" onclick={`openTeamModal(${idx+3})`}>
                See more
              </button>
            </div>
          </div>
        ))}
      </div>
      {/* Modals for each member */}
      {membersWithContent.map((member, idx) => (
        <div id={`team-modal-${idx}`} class="team-modal fixed inset-0 bg-black bg-opacity-60 flex items-center justify-center z-50 hidden">
          <div class="bg-white rounded-xl shadow-2xl max-w-lg w-full p-8 relative">
            <button class="absolute top-2 right-2 text-2xl text-gray-400 hover:text-gray-800" onclick={`closeTeamModal(${idx})`}>&times;</button>
            {member.image ? (
              <img
                src={member.image}
                alt={member.name}
                class="w-32 h-32 rounded-full object-cover border-4 border-white shadow mx-auto mb-4"
              />
            ) : (
              <div class={`w-32 h-32 bg-${member.color} rounded-full flex items-center justify-center text-white text-5xl font-bold border-4 border-white shadow mx-auto mb-4`}>
                {member.initials}
              </div>
            )}
            <h3 class="text-2xl font-bold text-center text-gray-800 mb-1">{member.name}</h3>
            <p class="text-lg text-center text-vividTangerine font-semibold mb-4">{member.role}</p>
            <div class="text-gray-700 prose prose-sm max-h-64 overflow-y-auto mx-auto text-center">
              <member.content.Content />
            </div>
          </div>
        </div>
      ))}
    </div>
    <div class="mt-12 text-center">
      <p class="text-2xl font-bold text-royalOrchid mb-4">This could be you!</p>
      <a href="#register" class="inline-block px-10 py-3 text-gray-200 bg-royalOrchid rounded-full shadow-md text-lg hover:bg-vividTangerine hover:border-vividTangerine hover:text-gray-800 transition-all">
        Join Us Today
      </a>
    </div>
  </div>
</div>
