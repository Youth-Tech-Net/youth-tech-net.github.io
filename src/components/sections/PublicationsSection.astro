---
import tagColors from "../../data/tagColors.json";
const { publications } = Astro.props;

// Helper to extract abstract section from markdown body
function extractAbstract(body) {
  const match = body.match(/## Abstract\n+([\s\S]*?)(\n+## |$)/);
  return match ? match[1].trim() : "";
}

// Only send the search fields needed by Fuse to the browser
const publicationSearchData = publications.map((pub) => ({
  slug: pub.slug,
  title: pub.data.title ?? "",
  tags: pub.data.tags ?? [],
  authors: pub.data.authors ?? [],
  draft: pub.data.draft ?? false,
}));
---

<section class="py-16 bg-white">
  <div class="max-w-5xl mx-auto px-4">
    <h1
      class="text-3xl sm:text-4xl font-bold text-royalOrchid mb-8 text-center"
    >
      Publications
    </h1>

    <div class="relative mb-8">
      <input
        id="search-input"
        type="text"
        placeholder="Search publications..."
        class="w-full px-4 py-2 border border-gray-300 rounded shadow focus:outline-none focus:ring-2 focus:ring-royalOrchid"
        autocomplete="off"
      />
      <ul
        id="search-dropdown"
        class="absolute left-0 right-0 bg-white border border-gray-200 rounded shadow z-10 mt-1 hidden"
      >
      </ul>
    </div>

    <div class="space-y-12">
      {
        publications.map((pub) => (
          <div class="flex flex-col border-b border-vanillaCustard pb-8 last:border-b-0 last:pb-0 bg-white rounded-lg shadow-lg">
            {pub.data.cover && (
              <img
                src={pub.data.cover}
                alt={pub.data.title + " cover"}
                class="w-full h-64 object-cover object-top rounded-t mb-4 shadow bg-gray-100"
                loading="lazy"
              />
            )}

            <div class="flex-1 px-4 md:px-8 py-4">
              <div class="flex items-center justify-between mb-2 mt-2 border-b border-gray-100 pb-2">
                <div class="flex items-center gap-2">
                  <a
                    href={`/publications/${pub.slug}/`}
                    title={pub.data.title}
                    class="text-2xl font-semibold text-royalOrchid hover:underline focus:outline-none"
                  >
                    {pub.data.title}
                  </a>
                  {(pub.data.draft === true || pub.data.draft === 'true') && (
                    <span class="ml-2 px-2 py-1 rounded bg-yellow-200 text-yellow-900 text-xs font-bold uppercase">Draft</span>
                  )}
                </div>

                {pub.data.pdf && (
                  <a
                    href={pub.data.pdf}
                    title="Download PDF"
                    download
                    class="ml-3 transition-transform duration-150 hover:scale-110 focus:outline-none"
                    style="line-height:0;"
                  >
                    <img
                      src="data:image/png;base64,"
                      alt="pdf"
                      class="h-5 w-5 inline-block align-middle drop-shadow-sm"
                      loading="lazy"
                    />
                  </a>
                )}
              </div>

              <div class="mb-2 text-sm text-gray-600">
                By {pub.data.authors.join(", ")}
              </div>

              <div class="mb-2 flex flex-wrap gap-2">
                {pub.data.tags.map((tag) => {
                  const colorClass = tagColors[tag] || tagColors["default"];
                  return (
                    <span class={colorClass + " px-2 py-1 rounded text-xs"}>
                      {tag}
                    </span>
                  );
                })}
              </div>

              <div class="mb-4 text-gray-700">
                <strong>Abstract:</strong> {extractAbstract(pub.body)}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <script type="module" define:vars={{ publicationSearchData }}>
    import { initPublicationSearch } from "../src/scripts/publications-search.js";

    initPublicationSearch(publicationSearchData);
  </script>
</section>
